		{
			"name": "2. Data Operations",
			"item": [
				{
					"name": "Add Supplier",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"FreshFoods\",\n  \"contact_no\": \"01001234567\"\n}"
						},
						"url": "http://localhost:3000/add-supplier"
					}
				},
				{
					"name": "Add Product",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Milk\",\n  \"price\": 15.00,\n  \"quantity\": 50,\n  \"supplier_name\": \"FreshFoods\"\n}"
						},
						"url": "http://localhost:3000/add-product"
					}
				},
				{
					"name": "Add Sale",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"product_name\": \"Milk\",\n  \"quantity\": 2,\n  \"sale_date\": \"2025-05-20\"\n}"
						},
						"url": "http://localhost:3000/add-sale"
					}
				},
				{
					"name": "Update Product Price",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"product_name\": \"Bread\",\n  \"price\": 25.00\n}"
						},
						"url": "http://localhost:3000/update-product-price"
					}
				},
				{
					"name": "Delete Product",
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"product_name\": \"Eggs\"\n}"
						},
						"url": "http://localhost:3000/delete-product"
					}
				}
			]
		},
